{
  "sourceLanguage": "en",
  "strings": {
    "A colour name, such as orange, or a hex value.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom de couleur, comme orange, ou une valeur hexadécimale."
          }
        }
      }
    },
    "An SF Symbol name, such as hammer.fill.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom de symbole SF, comme hammer.fill."
          }
        }
      }
    },
    "Close the Prompter": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer le prompteur"
          }
        }
      }
    },
    "Colour": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur"
          }
        }
      }
    },
    "End ${title} in the notch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer ${title} dans l’encoche"
          }
        }
      }
    },
    "End Notch Activity": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer une activité de l’encoche"
          }
        }
      }
    },
    "From 0 to 1.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 0 à 1."
          }
        }
      }
    },
    "Col works best from Applications: it can open at login and update itself there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Col fonctionne mieux depuis Applications : il peut s’y ouvrir à la connexion et s’y mettre à jour."
          }
        }
      }
    },
    "Marks an activity done: a check mark, then it leaves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque une activité comme terminée : une coche, puis elle s’en va."
          }
        }
      }
    },
    "Minutes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes"
          }
        }
      }
    },
    "Move Col to the Applications folder?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer Col dans le dossier Applications ?"
          }
        }
      }
    },
    "Move to Applications": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer dans Applications"
          }
        }
      }
    },
    "Not Now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard"
          }
        }
      }
    },
    "Open the Island": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir l’île"
          }
        }
      }
    },
    "Play or Pause the Prompter": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire ou mettre en pause le prompteur"
          }
        }
      }
    },
    "Progress": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression"
          }
        }
      }
    },
    "Prompt Text": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire défiler un texte"
          }
        }
      }
    },
    "Prompt the Selected Script": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire défiler le script sélectionné"
          }
        }
      }
    },
    "Prompter": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompteur"
          }
        }
      }
    },
    "Rolls a text out of the notch in the prompter.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait défiler un texte depuis l’encoche, dans le prompteur."
          }
        }
      }
    },
    "Rolls the script selected in the prompter's library.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait défiler le script sélectionné dans la bibliothèque du prompteur."
          }
        }
      }
    },
    "Seconds on screen": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondes à l’écran"
          }
        }
      }
    },
    "Show ${title} in the notch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher ${title} dans l’encoche"
          }
        }
      }
    },
    "Show in the Notch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans l’encoche"
          }
        }
      }
    },
    "Shows a live activity beside the camera, or updates the one with the same name.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une activité en direct à côté de la caméra, ou met à jour celle du même nom."
          }
        }
      }
    },
    "Start a ${minutes} minute timer in the notch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer un minuteur de ${minutes} minutes dans l’encoche"
          }
        }
      }
    },
    "Start a Notch Timer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer un minuteur dans l’encoche"
          }
        }
      }
    },
    "Starts a countdown that lives in the notch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un compte à rebours qui vit dans l’encoche."
