{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet reads the battery of your AirPods and other headphones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet lit la batterie de vos AirPods et autres écouteurs."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet shows your next events in the notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet affiche vos prochains événements dans l’encoche."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet uses the camera only when you open its mirror."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet n’utilise la caméra que lorsque vous ouvrez son miroir."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet reaches the devices you choose on your network, and only them: your phone for the prompter's remote, and the AI servers you add."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet joint les appareils que vous choisissez sur votre réseau, et eux seuls : votre téléphone pour la télécommande du prompteur, et les serveurs d’IA que vous ajoutez."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompter listens to your voice to roll the script as you speak. The sound never leaves your Mac and is never recorded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompteur écoute votre voix pour faire défiler le script quand vous parlez. Le son ne quitte jamais votre Mac et n’est jamais enregistré."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet shows the reminders due today beside your agenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Islet affiche les rappels du jour à côté de votre agenda."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Voice Follow, the prompter recognizes your words on your Mac to keep your place in the script."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En suivi de la voix, le prompteur reconnaît vos mots sur votre Mac pour garder votre place dans le script."
          }
        }
      }
    }
  },
  "version": "1.0"
}
