<UserControl x:Class="Col.Island.HomePage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Col.Localization"
             FontFamily="{StaticResource Island.Font}" Foreground="{StaticResource Island.Text}">
    <Grid>
        <!-- Nothing plays: the time, and a word on where the music comes from. -->
        <Grid x:Name="Idle" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock x:Name="Clock" FontFamily="{StaticResource Island.DisplayFont}" FontSize="46" FontWeight="Light"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="Date" FontSize="13" Foreground="{StaticResource Island.Secondary}" Margin="2,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="190">
                <ContentPresenter x:Name="IdleGlyph" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="{l:Loc Home_NothingPlaying}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{l:Loc Home_NothingPlaying_Detail}" FontSize="11.5" Foreground="{StaticResource Island.Secondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- The player, and the song's words beside it. -->
        <Grid x:Name="Playing">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlayerColumn" Width="196" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="ArtworkSlot" Width="54" Height="54" />
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Title" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Artist" FontSize="12.5" Foreground="{StaticResource Island.Secondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Scrubber" Background="Transparent" Cursor="Hand">
                        <Border x:Name="ScrubTrack" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                        <Border x:Name="ScrubFill" Height="4" CornerRadius="2" Background="White" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Width="0" />
                    </Grid>
                    <TextBlock x:Name="Elapsed" Grid.Row="1" FontSize="10.5" Foreground="{StaticResource Island.Tertiary}"
                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left" />
                    <TextBlock x:Name="Remaining" Grid.Row="1" FontSize="10.5" Foreground="{StaticResource Island.Tertiary}"
                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,-4">
                    <Button x:Name="PreviousButton" Style="{StaticResource Island.IconButton}" Width="36" Height="36" />
                    <Button x:Name="PlayButton" Style="{StaticResource Island.IconButton}" Width="40" Height="40" Margin="14,0" />
                    <Button x:Name="NextButton" Style="{StaticResource Island.IconButton}" Width="36" Height="36" />
                </StackPanel>
            </Grid>

            <Grid x:Name="LyricsArea" Grid.Column="2" ClipToBounds="True" Background="Transparent">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.16" />
                        <GradientStop Color="#FF000000" Offset="0.8" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <StackPanel x:Name="Lines" VerticalAlignment="Top">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="LinesShift" />
                    </StackPanel.RenderTransform>
                </StackPanel>
                <StackPanel x:Name="LyricsNote" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="200">
                    <ContentPresenter x:Name="NoteGlyph" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock x:Name="NoteText" FontSize="12" Foreground="{StaticResource Island.Secondary}" TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
