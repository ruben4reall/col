<UserControl x:Class="Col.Island.PermissionCard" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Col.Localization"
             FontFamily="{StaticResource Island.Font}" Foreground="{StaticResource Island.Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Who asks, for which project, with which tool. -->
        <DockPanel>
            <ContentPresenter x:Name="Logo" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Border x:Name="ToolChip" DockPanel.Dock="Right" Background="{StaticResource Island.Fill}" CornerRadius="10"
                    Padding="9,2,9,3" VerticalAlignment="Center">
                <TextBlock x:Name="Tool" FontSize="11.5" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="Queue" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Island.Secondary}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="Heading" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The whole command, every character visible, in a fixed-width font. -->
        <Border Grid.Row="1" Background="#17FFFFFF" CornerRadius="12" Margin="0,10,0,0" Padding="12,8,6,8">
            <ScrollViewer Style="{StaticResource Island.Scroll}">
                <TextBlock x:Name="Command" FontFamily="{StaticResource Island.Mono}" FontSize="12" LineHeight="17"
                           TextWrapping="Wrap" Margin="0,0,8,0" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="Note" Grid.Row="2" FontSize="11.5" Foreground="{StaticResource Island.Orange}" Margin="2,6,0,0"
                   TextWrapping="Wrap" Text="{l:Loc Card_TooLong}" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Deny" Style="{StaticResource Island.Pill}" Content="{l:Loc Card_Deny}" AutomationProperties.AutomationId="Deny" />
            <Button x:Name="Allow" Grid.Column="2" Style="{StaticResource Island.Pill}" Content="{l:Loc Card_Allow}" AutomationProperties.AutomationId="Allow"
                    Background="{StaticResource Island.Blue}" />
        </Grid>
    </Grid>
</UserControl>
