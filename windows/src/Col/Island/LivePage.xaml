<UserControl x:Class="Col.Island.LivePage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Col.Localization"
             FontFamily="{StaticResource Island.Font}" Foreground="{StaticResource Island.Text}">
    <Grid>
        <ScrollViewer Style="{StaticResource Island.Scroll}">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
            <ContentPresenter x:Name="EmptyGlyph" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="{l:Loc Live_Empty}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Loc Live_Empty_Detail}" FontSize="11.5" Foreground="{StaticResource Island.Secondary}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
