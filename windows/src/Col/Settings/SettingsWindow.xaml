<Window x:Class="Col.Settings.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Col.Localization"
        Title="{l:Loc Settings_Title}" Width="940" Height="680" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="{StaticResource Win.Font}" FontSize="14" Foreground="{DynamicResource Win.Text}"
        Background="{DynamicResource Win.Background}" Icon="pack://application:,,,/Assets/col-64.png"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation. -->
        <StackPanel Margin="12,14,8,12">
            <StackPanel Orientation="Horizontal" Margin="10,2,0,18">
                <Image Source="pack://application:,,,/Assets/col-64.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Col" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Win.Badge}" CornerRadius="4" Padding="6,1,6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Settings_Preview}" FontSize="11" Foreground="{DynamicResource Win.Text.Secondary}" />
                </Border>
            </StackPanel>
            <RadioButton x:Name="NavGeneral" Style="{StaticResource Win.Nav}" Tag="&#xE713;" Content="{l:Loc Nav_General}" IsChecked="True" />
            <RadioButton x:Name="NavMusic" Style="{StaticResource Win.Nav}" Tag="&#xE8D6;" Content="{l:Loc Nav_Music}" />
            <RadioButton x:Name="NavAgents" Style="{StaticResource Win.Nav}" Tag="&#xE943;" Content="{l:Loc Nav_Agents}" />
            <RadioButton x:Name="NavAbout" Style="{StaticResource Win.Nav}" Tag="&#xE946;" Content="{l:Loc Nav_About}" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" Style="{StaticResource Win.ScrollViewer}">
            <StackPanel Margin="20,12,36,36" MaxWidth="1000">
                <TextBlock x:Name="PageTitle" FontFamily="{StaticResource Win.DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,10" />

                <!-- General. -->
                <StackPanel x:Name="GeneralPage">
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE7E8;" />
                            <CheckBox x:Name="LaunchAtLogin" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Launch}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Launch_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Win.Section}" Text="{l:Loc General_Island}" />
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE7F4;" />
                            <CheckBox x:Name="VisibleAtRest" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_AtRest}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_AtRest_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE962;" />
                            <CheckBox x:Name="OpenOnHover" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Hover}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Hover_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE945;" />
                            <CheckBox x:Name="IntroToggle" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Intro}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Intro_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE767;" />
                            <CheckBox x:Name="IntroSoundToggle" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_IntroSound}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE740;" />
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Win.Control}" BorderBrush="{DynamicResource Win.Control.Stroke}"
                                    BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SizeCompact" Style="{StaticResource Win.Segment}" GroupName="Size" Content="{l:Loc Size_Compact}" />
                                    <RadioButton x:Name="SizeStandard" Style="{StaticResource Win.Segment}" GroupName="Size" Content="{l:Loc Size_Standard}" />
                                    <RadioButton x:Name="SizeLarge" Style="{StaticResource Win.Segment}" GroupName="Size" Content="{l:Loc Size_Large}" />
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Size}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Size_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE7F8;" VerticalAlignment="Top" Margin="2,2,18,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Display}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Display_Detail}" />
                                <StackPanel x:Name="MonitorChoices" Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Win.Section}" Text="{l:Loc General_Shows}" />
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE767;" />
                            <CheckBox x:Name="VolumeDisplay" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Volume}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Volume_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE83F;" />
                            <CheckBox x:Name="BatteryDisplay" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Battery}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Battery_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE77F;" />
                            <CheckBox x:Name="ClipboardToggle" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc General_Clipboard}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc General_Clipboard_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Music and lyrics. -->
                <StackPanel x:Name="MusicPage" Visibility="Collapsed">
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE8D6;" />
                            <CheckBox x:Name="NowPlayingToggle" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc Music_NowPlaying}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc Music_NowPlaying_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Win.Section}" Text="{l:Loc Music_Lyrics}" />
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE8D2;" />
                            <CheckBox x:Name="LyricsToggle" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc Music_SyncedLyrics}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc Music_SyncedLyrics_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE7F4;" />
                            <CheckBox x:Name="LyricLineClosed" DockPanel.Dock="Right" Style="{StaticResource Win.Toggle}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc Music_LineClosed}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc Music_LineClosed_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE74D;" />
                            <Button x:Name="ClearLyrics" DockPanel.Dock="Right" Style="{StaticResource Win.Button}" Content="{l:Loc Music_Clear}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc Music_Cache}" />
                                <TextBlock x:Name="CacheDetail" Style="{StaticResource Win.CardDetail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Coding agents. -->
                <StackPanel x:Name="AgentsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Win.CardDetail}" FontSize="14" Text="{l:Loc Agents_Intro}" Margin="1,0,0,14" />
                    <StackPanel x:Name="AgentCards" />
                    <TextBlock Style="{StaticResource Win.Section}" Text="{l:Loc Agents_Scripts}" />
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE756;" VerticalAlignment="Top" Margin="2,2,18,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="colctl" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc Agents_Colctl_Detail}" />
                                <Border Background="{DynamicResource Win.Control}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                        HorizontalAlignment="Left">
                                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Text="colctl push build --title Build --progress 40%" />
                                </Border>
                                <TextBlock x:Name="ColctlPath" Style="{StaticResource Win.CardDetail}" Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- About. -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <Border Style="{StaticResource Win.Card}" Padding="20,18">
                        <DockPanel>
                            <Image Source="pack://application:,,,/Assets/col-256.png" Width="64" Height="64" Margin="0,0,18,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc About_Name}" FontFamily="{StaticResource Win.DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Win.CardDetail}" FontSize="13" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" FontSize="13" Text="{l:Loc About_Tagline}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc About_License}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="LinkWebsite" Style="{StaticResource Win.LinkButton}" Content="{l:Loc About_Website}" Margin="0,0,20,0" />
                                <Button x:Name="LinkSource" Style="{StaticResource Win.LinkButton}" Content="{l:Loc About_Source}" Margin="0,0,20,0" />
                                <Button x:Name="LinkChangelog" Style="{StaticResource Win.LinkButton}" Content="{l:Loc About_Changelog}" Margin="0,0,20,0" />
                                <Button x:Name="LinkIssues" Style="{StaticResource Win.LinkButton}" Content="{l:Loc About_Issues}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE72E;" VerticalAlignment="Top" Margin="2,2,18,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc About_Privacy}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc About_Privacy_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Win.Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Win.CardIcon}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="2,2,18,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Win.CardTitle}" Text="{l:Loc About_Unsigned}" />
                                <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc About_Unsigned_Detail}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Win.CardDetail}" Text="{l:Loc About_Credits}" Margin="1,10,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
