    },
    "The script rolls at this speed while you speak and waits as soon as you stop. Your voice is heard on your Mac and never recorded.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script défile à cette vitesse pendant que vous parlez et attend dès que vous vous arrêtez. Votre voix est entendue sur votre Mac et jamais enregistrée."
          }
        }
      }
    },
