    "Kept in memory only, never written to disk. Copies from password managers are skipped.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardées en mémoire seulement, jamais écrites sur le disque. Les copies des gestionnaires de mots de passe sont ignorées."
          }
        }
      }
    },
