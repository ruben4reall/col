          }
        }
      }
    },
    "Tiroir’s drawers, profiles and look came along.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tiroirs, les profils et l’apparence de Tiroir ont suivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schubladen, Profile und das Aussehen von Tiroir wurden übernommen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laden, profielen en het uiterlijk van Tiroir zijn meegekomen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cassetti, i profili e l’aspetto di Tiroir sono stati ripresi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cajones, los perfiles y el aspecto de Tiroir se han traído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gavetas, os perfis e a aparência do Tiroir vieram junto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroirの引き出し、プロファイル、外観を引き継ぎました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir의 서랍, 프로필, 모양을 그대로 가져왔습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已沿用 Tiroir 的抽屉、场景和外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已沿用 Tiroir 的抽屜、情境和外觀。"
          }
        }
      }
    },
    "Turn this off, or quit Col, and every icon comes back to the menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette option ou quittez Col, et chaque icône revient dans la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren Sie diese Option oder beenden Sie Col, und jedes Symbol kehrt in die Menüleiste zurück."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel dit uit of stop Col, en elk symbool komt terug in de menubalk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l’opzione o esci da Col, e ogni icona torna nella barra dei menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva esta opción o sal de Col, y cada icono vuelve a la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative esta opção ou encerre o Col, e cada ícone volta para a barra de menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオプションをオフにするかColを終了すると、すべてのアイコンがメニューバーに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 끄거나 Col을 종료하면 모든 아이콘이 메뉴 막대로 돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此选项或退出 Col 后，所有图标都会回到菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此選項或結束 Col 後，所有圖像都會回到選單列。"
          }
        }
      }
    },
    "Tiroir is open": {
      "localizations": {
