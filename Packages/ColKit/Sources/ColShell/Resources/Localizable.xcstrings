    "On the notch: it opens at once. Swipe up to close.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’encoche : elle s’ouvre aussitôt. Vers le haut pour fermer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Notch: Sie öffnet sich sofort. Zum Schließen nach oben streichen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de notch: het gaat meteen open. Veeg omhoog om te sluiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul notch: si apre subito. Scorri verso l’alto per chiudere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la muesca: se abre al instante. Desliza hacia arriba para cerrarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No notch: ela abre na hora. Deslize para cima para fechar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチ上ではすぐに開きます。上にスワイプすると閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에서: 바로 열립니다. 위로 쓸어올리면 닫힙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海上：立即打开。向上轻扫即可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海上：立即打開。向上滑動即可關閉。"
          }
        }
      }
    },
