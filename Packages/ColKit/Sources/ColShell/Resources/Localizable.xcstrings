    "Sorts every icon again, by purpose or by developer, and shows the result before it applies.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range à nouveau chaque icône, par usage ou par développeur, et montre le résultat avant de l’appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert alle Symbole neu, nach Zweck oder nach Entwickler, und zeigt das Ergebnis, bevor es angewendet wird."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteert elk symbool opnieuw, op doel of op ontwikkelaar, en toont het resultaat voordat het wordt toegepast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina di nuovo ogni icona, per uso o per sviluppatore, e mostra il risultato prima di applicarlo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ordenar cada icono, por uso o por desarrollador, y muestra el resultado antes de aplicarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza de novo cada ícone, por finalidade ou por desenvolvedor, e mostra o resultado antes de aplicar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアイコンを用途別または開発元別にもう一度整理し、適用する前に結果を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 아이콘을 용도별 또는 개발자별로 다시 정리하고, 적용하기 전에 결과를 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按用途或按开发者重新整理每个图标，并在应用前显示结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按用途或按開發者重新整理每個圖像，並在套用前顯示結果。"
          }
        }
      }
    },
