    "Col closed it, so your shortcuts drive only one prompter. Souffleur can go to the Trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Col l’a fermé pour que vos raccourcis ne pilotent qu’un seul prompteur. Souffleur peut aller à la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Col hat es beendet, damit Ihre Tastaturkurzbefehle nur einen Prompter steuern. Souffleur kann in den Papierkorb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Col heeft het gestopt, zodat je toetscombinaties maar één prompter bedienen. Souffleur mag naar de prullenmand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Col l’ha chiuso, così le tue abbreviazioni da tastiera controllano un solo prompter. Puoi spostare Souffleur nel Cestino."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Col lo ha cerrado para que tus atajos controlen un solo teleprompter. Ya puedes trasladar Souffleur a la papelera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Col o fechou para que seus atalhos controlem um só teleprompter. O Souffleur já pode ir para o Lixo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットで操作するプロンプターが1つだけになるように、ColがSouffleurを終了しました。Souffleurはゴミ箱に入れてかまいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키가 하나의 프롬프터만 제어하도록 Col이 Souffleur를 닫았습니다. Souffleur는 휴지통으로 옮겨도 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Col 已将其关闭，这样你的快捷键只会控制一个提词器。Souffleur 可以移到废纸篓了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Col 已將其關閉，這樣你的快速鍵只會控制一個提詞機。Souffleur 可以丟到垃圾桶了。"
          }
        }
      }
    },
