    "Another app already uses %@. Quit it or change its shortcut, then turn this off and on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise déjà %@. Quittez-la ou changez son raccourci, puis désactivez et réactivez ceci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App verwendet bereits %@. Beenden Sie sie oder ändern Sie ihren Tastaturkurzbefehl und schalten Sie diese Option dann aus und wieder ein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app gebruikt %@ al. Stop die app of wijzig de toetscombinatie ervan, en zet dit daarna uit en weer aan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app usa già %@. Chiudila o cambia la sua abbreviazione da tastiera, poi disattiva e riattiva questa opzione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa %@. Ciérrala o cambia su atajo, y luego desactiva y vuelve a activar esta opción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app já usa %@. Encerre-o ou altere o atalho dele, depois desative e reative esta opção."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリがすでに%@を使用しています。そのアプリを終了するかショートカットを変更してから、この設定をオフにしてもう一度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 이미 %@을(를) 사용하고 있습니다. 해당 앱을 종료하거나 단축키를 변경한 다음, 이 옵션을 껐다가 다시 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 已在使用 %@。请退出该 App 或更改其快捷键，然后将此选项关闭再打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 App 已在使用 %@。請結束該 App 或更改其快速鍵，然後將此選項關閉再打開。"
          }
        }
      }
    },
