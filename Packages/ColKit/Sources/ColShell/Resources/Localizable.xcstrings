    "%@ connected: the island shows them, with their battery, as they connect.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est connecté : l’île l’affiche avec sa batterie à chaque connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verbunden: Die Insel zeigt das Gerät bei jeder Verbindung mit seinem Batteriestand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is verbonden: het eiland toont het apparaat met zijn batterij bij elke verbinding."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connesso: l’isola lo mostra con la sua batteria a ogni connessione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha conectado: la isla muestra tus dispositivos, con su batería, en cuanto se conectan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se conectou: a ilha mostra seus dispositivos, com a bateria, assim que eles se conectam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が接続されました。デバイスが接続されると、アイランドにバッテリー残量とともに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결됨: 연결될 때마다 아일랜드에 배터리와 함께 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接：每次连接时，岛都会显示它及其电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連接：每次連接時，島都會顯示它及其電量。"
          }
        }
      }
    },
    "%@ did not answer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht geantwortet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft niet geantwoord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha risposto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha respondido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から応答がありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有回應。"
          }
        }
      }
    },
    "%@ loaded": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en mémoire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geladen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geladen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caricato"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en memoria"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na memória"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込み済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 로드됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已载入 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已載入 %@"
          }
        }
      }
    },
    "%@ on this Mac: whatever plays shows in the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur ce Mac : ce qui joue s’affiche dans l’île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf diesem Mac: Was gerade läuft, erscheint auf der Insel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ op deze Mac: wat er ook speelt, verschijnt op het eiland."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ su questo Mac: qualunque cosa sia in riproduzione appare nell’isola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en este Mac: lo que suene aparece en la isla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ neste Mac: o que estiver tocando aparece na ilha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの%@。再生中のものがアイランドに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 %@: 무엇을 재생하든 아일랜드에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上的 %@：无论播放什么，都会显示在岛中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上的 %@：無論播放什麼，都會顯示在島中。"
          }
        }
      }
    },
    "%@, a tap away; your own AI servers too, and a question to them from the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à portée de clic ; vos propres serveurs d’IA aussi, et une question posée depuis l’île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, nur einen Klick entfernt; dazu Ihre eigenen KI-Server und eine Frage an sie direkt von der Insel aus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, met één klik bereikbaar; ook je eigen AI-servers, en een vraag aan hen vanaf het eiland."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, a portata di clic; anche i tuoi server IA, e una domanda per loro direttamente dall’isola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, a un clic; también tus propios servidores de IA, y una pregunta para ellos desde la isla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, a um clique; seus próprios servidores de IA também, e uma pergunta para eles direto da ilha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にワンクリックでアクセス。自分のAIサーバにも、アイランドから質問できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 탭 한 번으로 열 수 있습니다. 사용자의 AI 서버도 마찬가지이며, 아일랜드에서 바로 질문할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 一点即达；你自己的 AI 服务器也一样，还能从岛中直接向它们提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 一按即達；你自己的 AI 伺服器也一樣，還能從島中直接向它們提問。"
          }
        }
      }
    },
    "%@, charging: plugging in and a low battery show in the notch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, en charge : le branchement et la batterie faible s’affichent dans l’encoche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt: Anschließen und niedriger Batteriestand werden in der Notch angezeigt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laadt op: aansluiten en een bijna lege batterij worden in de notch getoond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in carica: il collegamento e la batteria quasi scarica appaiono nel notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, en carga: la conexión del cargador y la batería baja se muestran en la muesca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, carregando: a conexão do carregador e a bateria fraca aparecem no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、充電中。電源の接続とバッテリー残量の低下がノッチに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 충전 중: 전원 연결 및 배터리 부족이 노치에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在充电：接入电源和电量不足都会显示在刘海中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在充電：接上電源和電量不足都會顯示在瀏海中。"
          }
        }
      }
    },
