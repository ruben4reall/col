    "Used only while the mirror is open. Seeing that another app uses the camera needs no permission.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée seulement quand le miroir est ouvert. Voir qu’une autre app utilise la caméra ne demande aucune autorisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, während der Spiegel geöffnet ist. Um zu erkennen, dass eine andere App die Kamera verwendet, ist keine Berechtigung nötig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gebruikt terwijl de spiegel open is. Om te zien dat een andere app de camera gebruikt, is geen toestemming nodig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata solo quando lo specchio è aperto. Per vedere che un’altra app usa la videocamera non serve alcuna autorizzazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa mientras el espejo está abierto. Saber que otra app usa la cámara no requiere ningún permiso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada só enquanto o espelho está aberto. Saber que outro app usa a câmera não exige nenhuma permissão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラーを開いている間だけ使用します。ほかのアプリがカメラを使っていることを知るのに、許可は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미러가 열려 있을 때만 사용됩니다. 다른 앱이 카메라를 사용하는지 확인하는 데는 권한이 필요하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在镜像打开时使用。得知其他 App 正在使用摄像头无需任何权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在鏡像打開時使用。得知其他 App 正在使用相機無需任何權限。"
          }
        }
      }
    },
