    "Lets your phone, a home server, Home Assistant or a build machine on this network push activities and widgets into the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à votre téléphone, à un serveur maison, à Home Assistant ou à une machine de build de ce réseau d’envoyer des activités et des widgets dans l’île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit können Ihr Smartphone, ein Heimserver, Home Assistant oder ein Build-Rechner in diesem Netzwerk Aktivitäten und Widgets an die Insel senden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je telefoon, een thuisserver, Home Assistant of een buildmachine op dit netwerk activiteiten en widgets naar het eiland sturen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette al tuo telefono, a un server di casa, a Home Assistant o a una macchina di build su questa rete di inviare attività e widget all’isola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tu teléfono, un servidor doméstico, Home Assistant o una máquina de compilación de esta red envíen actividades y widgets a la isla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que seu celular, um servidor doméstico, o Home Assistant ou uma máquina de compilação desta rede enviem atividades e widgets para a ilha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワーク上のスマートフォン、ホームサーバ、Home Assistant、ビルドマシンから、アイランドにアクティビティやウィジェットを送信できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크의 휴대폰, 홈 서버, Home Assistant 또는 빌드 머신이 아일랜드로 활동과 위젯을 보낼 수 있게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让此网络上的手机、家庭服务器、Home Assistant 或构建机将活动和小组件推送到岛中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓此網路上的手機、家用伺服器、Home Assistant 或建置機器將活動和小工具推送到島中。"
          }
        }
      }
    },
