    "The icons of your menu bar, tidied into drawers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes de votre barre des menus, rangées dans des tiroirs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbole Ihrer Menüleiste, in Schubladen aufgeräumt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De symbolen van je menubalk, opgeruimd in laden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le icone della barra dei menu, riordinate in cassetti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los iconos de tu barra de menús, ordenados en cajones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ícones da barra de menus, organizados em gavetas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアイコンを引き出しに整理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 아이콘을 서랍에 정리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将菜单栏的图标整理进抽屉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將選單列的圖像整理進抽屜。"
          }
        }
      }
    },
    "Tidy the menu bar into drawers": {
      "localizations": {
