    "An example: when %@ asks to run a command, the island opens with Allow and Deny.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un exemple : quand %@ demande à lancer une commande, l’île s’ouvre avec Autoriser et Refuser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Beispiel: Wenn %@ einen Befehl ausführen möchte, öffnet sich die Insel mit „Erlauben“ und „Ablehnen“."
          }
        },
        "nl": {
          "stringUnit": {
