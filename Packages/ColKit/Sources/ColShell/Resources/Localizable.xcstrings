{
  "sourceLanguage": "en",
  "strings": {
    "%@ answers, with %lld models.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ answers, with %#@models@."
          },
          "substitutions": {
            "models": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg model"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg models"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ répond, avec %#@models@."
          },
          "substitutions": {
            "models": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg modèle"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg modèles"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ connected: the island shows them, with their battery, as they connect.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est connecté : l’île l’affiche avec sa batterie à chaque connexion."
          }
        }
      }
    },
    "%@ did not answer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu."
          }
        }
      }
    },
    "%@ loaded": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en mémoire"
          }
        }
      }
    },
    "%@ on this Mac: whatever plays shows in the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sur ce Mac : ce qui joue s’affiche dans l’île."
          }
        }
      }
    },
    "%@, a tap away; your own AI servers too, and a question to them from the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à portée de clic ; vos propres serveurs d’IA aussi, et une question posée depuis l’île."
          }
        }
      }
    },
    "%@, charging: plugging in and a low battery show in the notch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, en charge : le branchement et la batterie faible s’affichent dans l’encoche."
          }
        }
      }
    },
    "%@, chosen in Col.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, choisi dans Col."
          }
        }
      }
    },
    "%@, like your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, comme votre Mac."
          }
        }
      }
    },
    "%@: Col does not speak %@ yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : Col ne parle pas encore %@."
          }
        }
      }
    },
    "%@: plugging in and a low battery show in the notch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : le branchement et la batterie faible s’affichent dans l’encoche."
          }
        }
      }
    },
    "%@: their sessions in the notch, and their permission requests answered from it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : leurs sessions dans l’encoche, et leurs demandes d’autorisation réglées depuis l’île."
          }
        }
      }
    },
