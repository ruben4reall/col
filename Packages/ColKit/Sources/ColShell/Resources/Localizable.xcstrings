        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰, 홈 서버 또는 빌드 머신에서 아일랜드로 보내기, 웹 위젯."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手机、家庭服务器或构建机向岛推送内容；来自网络的小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手機、家用伺服器或建置機器向島推送內容；來自網路的小工具。"
          }
        }
      }
    },
