    "Until you allow it, the bars dance on their own, as before.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous ne l’autorisez pas, les barres dansent toutes seules, comme avant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Sie es erlauben, tanzen die Balken wie bisher von allein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totdat je het toestaat, dansen de balkjes zoals voorheen op eigen houtje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non lo consenti, le barre ballano da sole, come prima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que lo permitas, las barras bailan por su cuenta, como antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até você permitir, as barras dançam sozinhas, como antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可するまでは、これまでどおりバーは独自に動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하기 전까지는 이전처럼 막대가 저절로 움직입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你允许之前，律动条会像以前一样自行舞动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你允許之前，律動條會像以前一樣自行舞動。"
          }
        }
      }
    },
