    "Right of the camera, in place of the bars, as far as the menu bar leaves room.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À droite de la caméra, à la place des barres, dans la place que laisse la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts von der Kamera, anstelle der Balken, soweit die Menüleiste Platz lässt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts van de camera, in plaats van de balkjes, zover de menubalk ruimte laat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A destra della videocamera, al posto delle barre, fin dove la barra dei menu lascia spazio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la derecha de la cámara, en lugar de las barras, hasta donde deje espacio la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À direita da câmera, no lugar das barras, até onde a barra de menus deixar espaço."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの右側、バーの代わりに、メニューバーが空けている範囲内で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 오른쪽에서 막대 대신, 메뉴 막대가 남겨 둔 공간만큼 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在摄像头右侧取代律动条，占用菜单栏留出的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在相機右側取代律動條，佔用選單列留出的空間。"
          }
        }
      }
    },
    "Right-click": {
      "localizations": {
        "fr": {
