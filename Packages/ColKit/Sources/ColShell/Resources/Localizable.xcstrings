    "Scripts, Shortcuts and col:// links all reach the same local API, which never listens on the network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, Raccourcis et liens col:// passent tous par la même API locale, qui n’écoute jamais sur le réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripts, Kurzbefehle und col://-Links erreichen alle dieselbe lokale API, die nie im Netzwerk lauscht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, Opdrachten en col://-links bereiken allemaal dezelfde lokale API, die nooit op het netwerk luistert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Script, Comandi Rapidi e link col:// raggiungono tutti la stessa API locale, che non è mai in ascolto sulla rete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los scripts, Atajos y enlaces col:// llegan a la misma API local, que nunca escucha en la red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts, Atalhos e links col:// chegam à mesma API local, que nunca escuta na rede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプト、ショートカット、col://リンクは、すべて同じローカルAPIを使用します。このAPIがネットワークで待ち受けることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트, 단축어 및 col:// 링크는 모두 동일한 로컬 API에 연결되며, 이 API는 네트워크에서 수신 대기하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本、快捷指令和 col:// 链接都会访问同一个本地 API，它从不在网络上监听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本、捷徑和 col:// 連結都會存取同一個本機 API，它從不在網路上監聽。"
          }
        }
      }
    },
