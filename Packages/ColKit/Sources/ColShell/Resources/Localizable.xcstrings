    "Drag icons between the menu bar, your drawers and Hidden; name each drawer and choose its icon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les icônes entre la barre des menus, vos tiroirs et « Masquées » ; nommez chaque tiroir et choisissez son icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie Symbole zwischen der Menüleiste, Ihren Schubladen und „Ausgeblendet“ hin und her; benennen Sie jede Schublade und wählen Sie ihr Symbol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep symbolen tussen de menubalk, je laden en 'Verborgen'; geef elke lade een naam en kies het symbool."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le icone tra la barra dei menu, i tuoi cassetti e “Nascoste”; dai un nome a ogni cassetto e scegli la sua icona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra iconos entre la barra de menús, tus cajones y “Ocultos”; pon nombre a cada cajón y elige su icono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ícones entre a barra de menus, suas gavetas e “Ocultos”; dê um nome a cada gaveta e escolha o ícone dela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー、引き出し、“非表示”の間でアイコンをドラッグし、各引き出しの名前とアイコンを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대, 서랍, ‘가려진 항목’ 사이에서 아이콘을 드래그하고, 각 서랍의 이름과 아이콘을 정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏、抽屉和“已隐藏”之间拖移图标；为每个抽屉命名并选择它的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列、抽屜和「已隱藏」之間拖移圖像；為每個抽屜命名並選擇它的圖像。"
          }
        }
      }
    },
