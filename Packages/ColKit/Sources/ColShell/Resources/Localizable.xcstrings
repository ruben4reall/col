    "They wait here until you drag them somewhere else.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils attendent ici jusqu’à ce que vous les glissiez ailleurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie warten hier, bis Sie sie woandershin ziehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze wachten hier tot je ze ergens anders naartoe sleept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano qui finché non li trascini altrove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperan aquí hasta que los arrastres a otro sitio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles esperam aqui até você arrastá-los para outro lugar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこかにドラッグするまで、ここで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳으로 드래그할 때까지 여기에서 기다립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会在这里等待，直到你将其拖到别处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會在這裡等待，直到你將其拖到別處。"
          }
        }
      }
    },
