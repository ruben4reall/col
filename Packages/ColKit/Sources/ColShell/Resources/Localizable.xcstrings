    "Connected. In Codex, run /hooks once and trust Col’s hooks.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté. Dans Codex, lancez /hooks une fois et approuvez les hooks de Col."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden. Führen Sie in Codex einmal /hooks aus und vertrauen Sie den Hooks von Col."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden. Voer in Codex één keer /hooks uit en vertrouw de hooks van Col."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso. In Codex, esegui /hooks una volta e considera attendibili gli hook di Col."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. En Codex, ejecuta /hooks una vez y confía en los hooks de Col."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. No Codex, execute /hooks uma vez e confie nos hooks do Col."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しました。Codexで/hooksを一度実行し、Colのフックを信頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되었습니다. Codex에서 /hooks를 한 번 실행하고 Col의 훅을 신뢰하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接。在 Codex 中运行一次 /hooks 并信任 Col 的 hook。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連接。在 Codex 中執行一次 /hooks 並信任 Col 的 hook。"
          }
        }
      }
    },
