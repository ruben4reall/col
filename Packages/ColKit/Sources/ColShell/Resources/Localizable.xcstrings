    "How far the closed island may reach beside the camera. It never covers a menu or an icon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’où l’île fermée peut s’étendre à côté de la caméra. Elle ne couvre jamais un menu ni une icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit die geschlossene Insel neben der Kamera reichen darf. Sie verdeckt nie ein Menü oder ein Symbol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver het gesloten eiland naast de camera mag reiken. Het bedekt nooit een menu of een symbool."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin dove può estendersi l’isola chiusa accanto alla videocamera. Non copre mai un menu o un’icona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta dónde puede extenderse la isla cerrada junto a la cámara. Nunca tapa un menú ni un icono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde a ilha fechada pode se estender ao lado da câmera. Ela nunca cobre um menu ou um ícone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたアイランドがカメラの横にどこまで広がるか。メニューやアイコンを覆うことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 아일랜드가 카메라 옆으로 얼마나 넓게 펼쳐질 수 있는지 설정합니다. 메뉴나 아이콘을 가리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起的岛在摄像头旁可延伸的宽度。它绝不会遮挡菜单或图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收合的島在相機旁可延伸的寬度。它絕不會遮擋選單或圖像。"
          }
        }
      }
    },
    "Let Col see the menu bar": {
      "localizations": {
