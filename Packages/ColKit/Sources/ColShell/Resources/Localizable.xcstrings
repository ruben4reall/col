    },
    "The prompter stays on your screen and out of screenshots, recordings and calls. Turn this off to show it in a tutorial.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompteur reste sur votre écran mais hors des captures, des enregistrements et des appels. Désactivez ceci pour le montrer dans un tutoriel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompter bleibt auf Ihrem Bildschirm, erscheint aber nicht in Bildschirmfotos, Aufnahmen und Anrufen. Deaktivieren Sie diese Option, um ihn in einem Tutorial zu zeigen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompter blijft op je scherm, maar buiten schermafbeeldingen, opnames en gesprekken. Zet dit uit om hem in een tutorial te tonen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompter resta sul tuo schermo ma fuori da istantanee, registrazioni e chiamate. Disattiva questa opzione per mostrarlo in un tutorial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teleprompter permanece en tu pantalla y fuera de capturas, grabaciones y llamadas. Desactiva esta opción para mostrarlo en un tutorial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teleprompter fica na sua tela e fora de capturas de tela, gravações e chamadas. Desative para mostrá-lo em um tutorial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプターは画面には表示されますが、スクリーンショット、収録、通話には映りません。チュートリアルで見せたい場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프터는 화면에는 표시되지만 스크린샷, 녹화 및 통화에는 나타나지 않습니다. 튜토리얼에서 보여 주려면 이 옵션을 끄세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提词器会留在你的屏幕上，但不会出现在截屏、录制和通话中。如需在教程中展示，请关闭此选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提詞機會留在你的螢幕上，但不會出現在截圖、錄製和通話中。如需在教學中展示，請關閉此選項。"
          }
        }
      }
    },
