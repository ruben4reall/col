    "“%@” by %@ is playing: the island shows it with its cover, and its controls.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » de %@ est en lecture : l’île l’affiche avec sa pochette et ses commandes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ von %@ läuft: Die Insel zeigt den Titel mit Cover und Steuerelementen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ van %@ speelt: het eiland toont het nummer met de albumhoes en de bedieningsknoppen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” di %@ è in riproduzione: l’isola lo mostra con la copertina e i controlli."
