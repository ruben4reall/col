    "Thank you: the wings now keep clear of every menu and icon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci : les ailes restent maintenant à l’écart de chaque menu et de chaque icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke: Die Flügel halten jetzt Abstand zu allen Menüs und Symbolen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt: de vleugels blijven nu weg van elk menu en elk symbool."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie: ora le ali restano lontane da ogni menu e icona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias: ahora las alas se mantienen lejos de todos los menús e iconos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado: agora as asas ficam longe de todos os menus e ícones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。これでウイングは、どのメニューやアイコンにも重ならなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다. 이제 날개가 모든 메뉴와 아이콘을 피해 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢：两翼现在会避开所有菜单和图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝：兩翼現在會避開所有選單和圖像。"
          }
        }
      }
    },
