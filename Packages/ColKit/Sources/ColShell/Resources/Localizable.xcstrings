    "Light runs around the notch, the island swells and sends out a few waves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un filet de lumière fait le tour de l’encoche, l’île s’étire et envoie quelques ondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht läuft um die Notch, die Insel wächst und sendet ein paar Wellen aus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht loopt rond de notch, het eiland zwelt op en zendt een paar golven uit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luce corre intorno al notch, l’isola si allarga e manda qualche onda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luz recorre el notch, la isla se agranda y lanza unas ondas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma luz contorna o notch, a ilha cresce e envia algumas ondas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチの周りを光が走り、アイランドが広がって波を送り出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 주위로 빛이 흐르고, 아일랜드가 커지며 물결을 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光沿着刘海流动，灵动岛舒展开来，荡出几道波纹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光沿著瀏海流動，動態島舒展開來，盪出幾道波紋。"
          }
        }
      }
    },
