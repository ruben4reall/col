    "Col did not answer. Is Connect still on, and the phone on the same network?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Col n’a pas répondu. Connect est-il toujours activé, et le téléphone sur le même réseau ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Col hat nicht geantwortet. Ist Connect noch aktiviert und das Smartphone im selben Netzwerk?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Col heeft niet geantwoord. Staat Connect nog aan, en zit de telefoon op hetzelfde netwerk?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Col non ha risposto. Connect è ancora attivo e il telefono è sulla stessa rete?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Col no ha respondido. ¿Sigue activado Connect y está el teléfono en la misma red?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Col não respondeu. O Connect continua ativado, e o celular está na mesma rede?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Colから応答がありません。Connectはオンのままで、スマートフォンは同じネットワークにありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Col이 응답하지 않았습니다. Connect가 아직 켜져 있고 휴대폰이 같은 네트워크에 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Col 没有响应。Connect 是否仍处于打开状态，手机是否在同一网络上？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Col 沒有回應。Connect 是否仍處於開啟狀態，手機是否在同一網路上？"
          }
        }
      }
    },
