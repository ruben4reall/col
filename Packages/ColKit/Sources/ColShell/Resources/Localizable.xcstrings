          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一款具備 AI 的程式碼編輯器：可從島中打開。"
          }
        }
      }
    },
    "A dot beside the camera while an app uses the microphone or the camera.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point à côté de la caméra quand une app utilise le micro ou la caméra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt neben der Kamera, während eine App das Mikrofon oder die Kamera verwendet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stip naast de camera terwijl een app de microfoon of de camera gebruikt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto accanto alla videocamera quando un’app usa il microfono o la videocamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto junto a la cámara mientras una app usa el micrófono o la cámara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto ao lado da câmera enquanto um app usa o microfone ou a câmera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがマイクやカメラを使用している間、カメラの横にドットが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 마이크나 카메라를 사용하는 동안 카메라 옆에 점이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
