    "Processor, memory, network and disk, measured only while you look.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, réseau et disque, mesurés seulement quand vous regardez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozessor, Speicher, Netzwerk und Festplatte, nur gemessen, während Sie hinsehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor, geheugen, netwerk en schijf, alleen gemeten terwijl je kijkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Processore, memoria, rete e disco, misurati solo mentre guardi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesador, memoria, red y disco, medidos solo mientras miras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processador, memória, rede e disco, medidos só enquanto você olha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセッサ、メモリ、ネットワーク、ディスク。見ている間だけ計測します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세서, 메모리, 네트워크 및 디스크. 사용자가 볼 때만 측정합니다."
          }
        },
        "zh-Hans": {
