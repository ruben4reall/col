        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bijbehorende agent, %@, verbind je hieronder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo agente, %@, si collega qui sotto."
          }
        },
        "es": {
