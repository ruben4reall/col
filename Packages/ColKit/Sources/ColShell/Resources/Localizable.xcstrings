    "Not available on this version of macOS: it relies on private functions that macOS no longer offers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible sur cette version de macOS : repose sur des fonctions privées que macOS n’offre plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser macOS-Version nicht verfügbar: Es werden private Funktionen benötigt, die macOS nicht mehr anbietet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet beschikbaar in deze versie van macOS: het gebruikt privéfuncties die macOS niet meer biedt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
