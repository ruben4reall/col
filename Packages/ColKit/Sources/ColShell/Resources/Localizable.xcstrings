        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: il collegamento e la batteria quasi scarica appaiono nel notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: la conexión del cargador y la batería baja se muestran en la muesca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a conexão do carregador e a bateria fraca aparecem no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：電源の接続とバッテリー残量の低下がノッチに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 전원 연결 및 배터리 부족이 노치에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：接入电源和电量不足都会显示在刘海中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：接上電源和電量不足都會顯示在瀏海中。"
          }
        }
      }
    },
    "%@: their sessions in the notch, and their permission requests answered from it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : leurs sessions dans l’encoche, et leurs demandes d’autorisation réglées depuis l’île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Sitzungen in der Notch und Berechtigungsanfragen, die Sie direkt dort beantworten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: hun sessies in de notch, en hun toestemmingsverzoeken die je daar beantwoordt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: le loro sessioni nel notch e le loro richieste di autorizzazione gestite da lì."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sus sesiones en la muesca, y sus solicitudes de permiso respondidas desde ella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: as sessões no notch, e os pedidos de permissão respondidos por ali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：セッションがノッチに表示され、許可のリクエストにもそこから応答できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 세션이 노치에 표시되고, 권한 요청에 노치에서 바로 응답할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：会话显示在刘海中，权限请求也可直接在那里回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：工作階段顯示在瀏海中，權限請求也可直接在那裡回應。"
          }
        }
      }
    },
