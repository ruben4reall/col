    "Drop files on the notch to keep them at hand, and AirDrop them from there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez des fichiers sur l’encoche pour les garder sous la main, et envoyez-les par AirDrop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie Dateien auf der Notch ab, um sie griffbereit zu haben, und senden Sie sie von dort per AirDrop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet bestanden neer op de notch om ze bij de hand te houden, en verstuur ze van daaruit met AirDrop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia i file sul notch per averli a portata di mano, e da lì inviali con AirDrop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta archivos en la muesca para tenerlos a mano y enviarlos por AirDrop desde allí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte arquivos no notch para deixá-los à mão e enviá-los por AirDrop dali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをノッチにドロップすると手元に置いておけて、そこからAirDropで送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 노치에 드롭하여 가까이 두고, 그곳에서 AirDrop으로 보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖放到刘海上，让它们随手可用，并可直接从那里用 AirDrop 发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案拖放到瀏海上，讓它們隨手可用，並可直接從那裡用 AirDrop 傳送。"
          }
        }
      }
    },
    "Each change also shows on the notch, at the top of your screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque changement se voit aussi sur l’encoche, en haut de votre écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung ist auch an der Notch oben auf Ihrem Bildschirm zu sehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke wijziging is ook te zien op de notch, bovenaan je scherm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modifica si vede anche sul notch, in cima allo schermo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio también se ve en la muesca, en la parte superior de tu pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada alteração também aparece no notch, no topo da tela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は、画面上部のノッチにも反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 변경 사항은 화면 상단의 노치에도 표시됩니다."
