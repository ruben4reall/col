    "A click or a two-finger swipe down always opens it at once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic ou un balayage à deux doigts vers le bas l’ouvre toujours immédiatement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick oder ein Streichen mit zwei Fingern nach unten öffnet sie immer sofort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klik of een veegbeweging met twee vingers omlaag opent het altijd meteen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic o uno scorrimento verso il basso con due dita la apre sempre subito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic o deslizar dos dedos hacia abajo siempre la abre al instante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique ou deslizar dois dedos para baixo sempre a abre na hora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするか2本指で下にスワイプすると、いつでもすぐに開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하거나 두 손가락으로 아래로 쓸어내리면 언제나 바로 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按或用双指向下轻扫，总能立即打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下或用兩指向下滑動，一律會立即打開它。"
          }
        }
      }
    },
    "A code editor with AI: open it from the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un éditeur de code avec IA : ouvrez-le depuis l’île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
