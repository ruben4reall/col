    "Your recent copies land here. They stay in memory; only the ones you pin are saved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dernières copies arrivent ici. Elles restent en mémoire ; seules celles que vous épinglez sont enregistrées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre letzten Kopien landen hier. Sie bleiben im Speicher; nur angeheftete werden gesichert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recente kopieën komen hier terecht. Ze blijven in het geheugen; alleen de kopieën die je vastzet, worden bewaard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue copie recenti arrivano qui. Restano in memoria; vengono salvate solo quelle che fissi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus copias recientes llegan aquí. Se quedan en la memoria; solo se guardan las que fijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas cópias recentes chegam aqui. Elas ficam na memória; só as que você fixar são salvas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近コピーしたものがここに表示されます。メモリ内にのみ保持され、保存されるのはピンで固定したものだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 복사한 항목이 여기에 표시됩니다. 메모리에만 보관되며, 고정한 항목만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近拷贝的内容会出现在这里。它们仅保留在内存中；只有你固定的内容才会被存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近拷貝的內容會出現在這裡。它們僅保留在記憶體中；只有你釘選的內容才會被儲存。"
          }
        }
      }
    },
    "Your script under the camera, at the pace of your voice": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre script sous la caméra, au rythme de votre voix"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Skript unter der Kamera, im Tempo Ihrer Stimme"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je script onder de camera, in het tempo van je stem"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo script sotto la videocamera, al ritmo della tua voce"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu guion bajo la cámara, al ritmo de tu voz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu roteiro sob a câmera, no ritmo da sua voz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの下に原稿を、声のペースで"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 아래에서 목소리 속도에 맞춰 흐르는 대본"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讲稿就在摄像头下方，跟随你的语速"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "講稿就在相機下方，跟隨你的語速"
          }
        }
      }
    },
