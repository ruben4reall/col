    "Files your browser is still writing. Asks to read the Downloads folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que votre navigateur écrit encore. Demande à lire le dossier Téléchargements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die Ihr Browser noch schreibt. Erfordert Lesezugriff auf den Ordner „Downloads“."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden die je browser nog aan het schrijven is. Vraagt om de map Downloads te mogen lezen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File che il browser sta ancora scrivendo. Chiede di leggere la cartella Download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que tu navegador aún está escribiendo. Pide leer la carpeta Descargas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos que o navegador ainda está gravando. Pede para ler a pasta Downloads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザが書き込み中のファイル。ダウンロードフォルダの読み取りを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저가 아직 기록 중인 파일입니다. 다운로드 폴더 읽기 권한을 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器仍在写入的文件。会请求读取“下载”文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器仍在寫入的檔案。會請求讀取「下載項目」檔案夾。"
          }
        }
      }
    },
