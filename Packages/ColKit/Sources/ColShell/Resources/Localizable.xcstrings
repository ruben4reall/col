    "“%@” is not a header name: letters, digits and dashes only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un nom d’en-tête : lettres, chiffres et tirets seulement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein Header-Name: nur Buchstaben, Ziffern und Bindestriche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is geen headernaam: alleen letters, cijfers en streepjes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un nome di intestazione: solo lettere, cifre e trattini."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es un nombre de cabecera: solo letras, números y guiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é um nome de cabeçalho: só letras, números e hifens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はヘッダ名ではありません。使用できるのは英字、数字、ハイフンだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 헤더 이름이 아닙니다. 문자, 숫자 및 대시만 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的标头名称：只能包含字母、数字和短横线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是有效的標頭名稱：只能包含字母、數字和連字號。"
          }
        }
      }
    },
    "A device sends its token with every request, in an Authorization: Bearer header. Removing a device takes its token back at once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil envoie son jeton avec chaque requête, dans un en-tête Authorization: Bearer. Retirer un appareil lui reprend son jeton aussitôt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät sendet seinen Token mit jeder Anfrage in einem Header Authorization: Bearer. Wenn Sie ein Gerät entfernen, wird sein Token sofort widerrufen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een apparaat stuurt zijn token mee met elk verzoek, in een header Authorization: Bearer. Als je een apparaat verwijdert, wordt zijn token meteen ingetrokken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo invia il suo token con ogni richiesta, in un’intestazione Authorization: Bearer. Rimuovendo un dispositivo, il suo token viene revocato subito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo envía su token con cada solicitud, en una cabecera Authorization: Bearer. Al quitar un dispositivo, se retira su token al instante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo envia o token dele em cada requisição, em um cabeçalho Authorization: Bearer. Remover um dispositivo revoga o token dele na hora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは、リクエストごとにAuthorization: Bearerヘッダでトークンを送信します。デバイスを削除すると、そのトークンはすぐに無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기는 모든 요청에 Authorization: Bearer 헤더로 토큰을 보냅니다. 기기를 제거하면 해당 토큰이 즉시 회수됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备会在每个请求的 Authorization: Bearer 标头中发送其令牌。移除设备会立即收回其令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置會在每個請求的 Authorization: Bearer 標頭中傳送其權杖。移除裝置會立即收回其權杖。"
          }
        }
      }
    },
    "A widget has three buttons at most.": {
      "localizations": {
