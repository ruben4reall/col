    "This version of macOS changed what the drawers rely on": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de macOS a modifié ce sur quoi les tiroirs s’appuient"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version hat geändert, worauf die Schubladen angewiesen sind"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van macOS heeft gewijzigd waar de laden op steunen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di macOS ha modificato ciò su cui si basano i cassetti"
          }
        },
