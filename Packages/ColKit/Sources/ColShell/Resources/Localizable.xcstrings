    "Below the menu bar suits a Mac whose notch area already shows something, such as its own Dynamic Island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Sous la barre des menus » convient à un Mac dont l’encoche montre déjà autre chose, comme sa propre Dynamic Island."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Unter der Menüleiste“ eignet sich für einen Mac, dessen Notch-Bereich bereits etwas anzeigt, etwa eine eigene Dynamic Island."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Onder de menubalk’ past bij een Mac waarvan het notchgebied al iets toont, zoals een eigen Dynamic Island."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sotto la barra dei menu” è adatto a un Mac la cui area del notch mostra già qualcosa, come una propria Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Debajo de la barra de menús” es adecuado para un Mac cuya zona de la muesca ya muestra algo, como su propia Dynamic Island."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Abaixo da barra de menus” é ideal para um Mac cuja área do notch já mostra algo, como a sua própria Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メニューバーの下」は、独自のDynamic Islandなど、ノッチの領域にすでに何かが表示されているMacに適しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘메뉴 막대 아래’는 노치 영역에 이미 무언가가 표시되는 Mac(예: 자체 Dynamic Island가 있는 Mac)에 적합합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 Mac 的刘海区域已显示其他内容（例如它自己的灵动岛），“在菜单栏下方”会更合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 Mac 的瀏海區域已顯示其他內容（例如它自己的動態島），「在選單列下方」會更合適。"
          }
        }
      }
    },
