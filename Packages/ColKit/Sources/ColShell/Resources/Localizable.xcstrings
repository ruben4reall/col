    "Its load beside the processor’s, measured only while you look.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa charge à côté de celle du processeur, mesurée seulement pendant que vous regardez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Auslastung neben der des Prozessors, nur gemessen, während Sie hinsehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De belasting naast die van de processor, alleen gemeten terwijl je kijkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo carico accanto a quello del processore, misurato solo mentre guardi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su carga junto a la del procesador, medida solo mientras miras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carga dele ao lado da do processador, medida só enquanto você olha."
          }
