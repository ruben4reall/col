    "%lld in your library. Drop a text, a Word document, a PDF or a presentation on it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dans votre bibliothèque. Déposez-y un texte, un document Word, un PDF ou une présentation."
