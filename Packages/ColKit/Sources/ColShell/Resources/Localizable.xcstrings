    "What plays, the time, the song’s words and your next event, each when there is something to show.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui joue, l’heure, les paroles et votre prochain rendez-vous, chacun quand il a quelque chose à montrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was gerade läuft, die Uhrzeit, der Songtext und Ihr nächster Termin, jeweils wenn es etwas zu zeigen gibt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er speelt, de tijd, de songtekst en je volgende activiteit, elk wanneer er iets te tonen is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa è in riproduzione, l’ora, il testo del brano e il tuo prossimo evento, ognuno quando c’è qualcosa da mostrare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que suena, la hora, la letra de la canción y tu próximo evento, cada uno cuando hay algo que mostrar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está tocando, a hora, a letra da música e seu próximo evento, cada um quando há algo para mostrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の曲、時刻、歌詞、次の予定。それぞれ表示するものがあるときに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 항목, 시간, 노래 가사, 다음 이벤트를 각각 표시할 내용이 있을 때 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的内容、时间、歌词和你接下来的日程，各自在有内容可显示时出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放的內容、時間、歌詞和你接下來的行程，各自在有內容可顯示時出現。"
          }
        }
      }
    },
