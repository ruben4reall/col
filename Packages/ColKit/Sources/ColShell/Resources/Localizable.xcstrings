    "Shows your next events beside the clock. Without it, the agenda stays empty.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos prochains événements à côté de l’heure. Sans lui, l’agenda reste vide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Ihre nächsten Termine neben der Uhr. Ohne diese Berechtigung bleibt die Agenda leer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont je volgende activiteiten naast de klok. Zonder deze toestemming blijft de agenda leeg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i tuoi prossimi eventi accanto all’orologio. Senza questa autorizzazione, l’agenda resta vuota."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus próximos eventos junto al reloj. Sin este permiso, la agenda queda vacía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra seus próximos eventos ao lado do relógio. Sem essa permissão, a agenda fica vazia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の横に次の予定を表示します。許可しないと、予定は空のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 옆에 다음 이벤트를 표시합니다. 이 권한이 없으면 일정이 비어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在时钟旁显示你接下来的日程。没有此权限，日程将保持空白。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在時鐘旁顯示你接下來的行程。沒有此權限，行程將保持空白。"
          }
        }
      }
    },
