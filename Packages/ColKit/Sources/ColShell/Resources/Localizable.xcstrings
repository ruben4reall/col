    },
    "Where the prompter appears": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où le prompteur apparaît"
          }
        }
      }
    },
    "Which app is listening or filming.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle app écoute ou filme."
          }
        }
      }
    },
    "While the prompter is open, Page Down moves on a line, or starts a paused take, and Page Up goes back. The rest of the time these keys work as usual.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le prompteur est ouvert, Page suivante avance d’une ligne, ou relance une prise en pause, et Page précédente revient en arrière. Le reste du temps, ces touches marchent comme d’habitude."
          }
        }
      }
    },
    "Width": {
      "localizations": {
