    "The address sends Col elsewhere (%lld): give the address it leads to.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse renvoie Col ailleurs (%lld) : donnez l’adresse vers laquelle elle mène."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse leitet Col woandershin weiter (%lld): Geben Sie die Zieladresse an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres stuurt Col door naar elders (%lld): geef het adres op waar het naartoe leidt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo rimanda Col altrove (%lld): indica l’indirizzo a cui porta."
          }
        },
        "es": {
