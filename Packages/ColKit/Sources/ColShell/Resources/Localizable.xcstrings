          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” de %@ está tocando: a ilha mostra a música com a capa e os controles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」（%@）を再生中です。アイランドにアートワークとコントロールが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’(%@) 재생 중: 아일랜드에 앨범 커버 및 제어 항목과 함께 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
