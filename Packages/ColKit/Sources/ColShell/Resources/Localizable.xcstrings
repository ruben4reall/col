        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其智能体 %@ 可在下方连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其代理 %@ 可在下方連接。"
