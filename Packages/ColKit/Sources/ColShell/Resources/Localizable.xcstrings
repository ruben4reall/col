    },
    "It swells, then opens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle gonfle, puis s’ouvre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wölbt sich und öffnet sich dann."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zwelt op en gaat dan open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si gonfia, poi si apre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece y luego se abre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela cresce e depois se abre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膨らんでから開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부풀어 오른 다음 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会先膨胀，然后打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會先膨脹，然後打開。"
          }
        }
      }
    },
    "It swells, then opens. The delay is in Appearance.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle gonfle, puis s’ouvre. Le délai se règle dans Apparence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wölbt sich und öffnet sich dann. Die Verzögerung stellen Sie unter „Erscheinungsbild“ ein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zwelt op en gaat dan open. De vertraging stel je in bij Weergave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si gonfia, poi si apre. Il ritardo si regola in Aspetto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece y luego se abre. El retraso se ajusta en Apariencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela cresce e depois se abre. O atraso é ajustado em Aparência."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膨らんでから開きます。待ち時間は「外観」で設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부풀어 오른 다음 열립니다. 지연 시간은 모양에서 설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会先膨胀，然后打开。延迟可在“外观”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會先膨脹，然後打開。延遲可在「外觀」中設定。"
          }
        }
      }
    },
    "Its agent, %@, connects below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son agent, %@, se relie plus bas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zugehörige Agent, %@, wird weiter unten verbunden."
