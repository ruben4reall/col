    "A tint for the menu bar, profiles that switch by themselves, and a shortcut for any icon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une teinte pour la barre des menus, des profils qui changent d’eux-mêmes, et un raccourci pour n’importe quelle icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tönung für die Menüleiste, Profile, die von selbst wechseln, und ein Kurzbefehl für jedes Symbol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tint voor de menubalk, profielen die vanzelf wisselen en een toetscombinatie voor elk symbool."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tinta per la barra dei menu, profili che cambiano da soli e un’abbreviazione per qualsiasi icona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tinte para la barra de menús, perfiles que cambian solos y un atajo para cualquier icono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tonalidade para a barra de menus, perfis que mudam sozinhos e um atalho para qualquer ícone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの色合い、自動で切り替わるプロファイル、あらゆるアイコンのショートカット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 색조, 스스로 전환되는 프로필, 모든 아이콘을 위한 단축키."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏色调、会自动切换的场景，以及任意图标的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列色調、會自動切換的情境，以及任意圖像的快速鍵。"
          }
        }
      }
    },
