          }
        }
      }
    },
    "Your own island, drawn by Col on your wallpaper with what it shows right now. It opens and closes like the one in the notch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre île, dessinée par Col sur votre fond d’écran avec ce qu’elle montre en ce moment. Elle s’ouvre et se ferme comme celle de l’encoche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre eigene Insel, von Col auf Ihr Hintergrundbild gezeichnet, mit dem, was sie gerade zeigt. Sie öffnet und schließt sich wie die in der Notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen eiland, door Col op je achtergrond getekend met wat het nu toont. Het gaat open en dicht zoals het eiland in de notch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua isola, disegnata da Col sul tuo sfondo con ciò che mostra in questo momento. Si apre e si chiude come quella nel notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propia isla, dibujada por Col sobre tu fondo de pantalla con lo que muestra en este momento. Se abre y se cierra como la de la muesca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua própria ilha, desenhada pelo Col sobre o seu papel de parede com o que ela mostra agora. Ela abre e fecha como a do notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Colが壁紙の上に描く、今の表示内容を映したあなたのアイランド。ノッチのアイランドと同じように開閉します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Col이 배경화면에 그린 나만의 아일랜드로, 지금 표시되는 내용을 보여 줍니다. 노치에 있는 아일랜드처럼 열리고 닫힙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的岛，由 Col 绘制在你的墙纸上，显示它此刻的内容。它会像刘海中的岛一样打开和关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的島，由 Col 繪製在你的背景圖片上，顯示它此刻的內容。它會像瀏海中的島一樣打開和關閉。"
          }
        }
      }
    },
