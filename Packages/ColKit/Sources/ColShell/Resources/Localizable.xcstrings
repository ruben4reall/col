            "state": "translated",
            "value": "Un editor de código con IA: ábrelo desde la isla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um editor de código com IA: abra-o pela ilha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIを搭載したコードエディタ。アイランドから開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 탑재된 코드 편집기입니다. 아일랜드에서 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
