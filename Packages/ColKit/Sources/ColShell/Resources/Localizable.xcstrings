          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en esta versión de macOS: depende de funciones privadas que macOS ya no ofrece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível nesta versão do macOS: depende de funções privadas que o macOS não oferece mais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのmacOSでは利用できません。macOSで提供されなくなった非公開機能を利用しているためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 macOS에서는 사용할 수 없습니다. macOS에서 더 이상 제공하지 않는 비공개 기능을 사용하기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此版本的 macOS 上不可用：它依赖 macOS 已不再提供的私有功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
