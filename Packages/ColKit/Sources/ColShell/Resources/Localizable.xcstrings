          "stringUnit": {
            "state": "translated",
            "value": "Anschließen und niedriger Batteriestand werden in der Notch angezeigt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aansluiten en een bijna lege batterij worden in de notch getoond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento e la batteria quasi scarica appaiono nel notch."
