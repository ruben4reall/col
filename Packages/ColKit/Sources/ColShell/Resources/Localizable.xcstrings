          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, a máxima e a mínima de hoje, as próximas horas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の天気、今日の最高・最低気温、この先の数時間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 날씨, 오늘의 최고 및 최저 기온, 시간별 날씨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
