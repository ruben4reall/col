    "Step aside for these apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’effacer devant ces apps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Apps Platz machen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga opzij voor deze apps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatti da parte per queste app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apartarse para estas apps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair de cena para estes apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリでは隠れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 앱 사용 시 숨기기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用这些 App 时自动隐藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用這些 App 時自動隱藏"
          }
        }
      }
    },
    "While one of them is in front, the island hides, as in full screen. Volume, alerts and requests still show.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l’une d’elles est au premier plan, l’île se cache, comme en plein écran. Le volume, les alertes et les demandes s’affichent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine davon im Vordergrund ist, verschwindet die Insel wie im Vollbildmodus. Lautstärke, Hinweise und Anfragen werden weiterhin angezeigt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een ervan op de voorgrond staat, verbergt het eiland zich, zoals bij schermvullende weergave. Volume, meldingen en verzoeken worden nog steeds getoond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una di loro è in primo piano, l’isola si nasconde, come a tutto schermo. Volume, avvisi e richieste appaiono comunque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras una de ellas está en primer plano, la isla se oculta, como en pantalla completa. El volumen, las alertas y las solicitudes se siguen mostrando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um deles está em primeiro plano, a ilha se esconde, como em tela cheia. Volume, alertas e pedidos continuam aparecendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリのいずれかが前面にある間は、フルスクリーンと同じようにアイランドが隠れます。音量、通知、リクエストは引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 중 하나가 맨 앞에 있으면 전체 화면에서처럼 아일랜드가 숨겨집니다. 음량, 알림 및 요청은 계속 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当其中一个 App 位于最前面时，岛会像在全屏幕时一样隐藏。音量、提示和请求仍会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當其中一個 App 位於最前面時，島會像在全螢幕時一樣隱藏。音量、提示和請求仍會顯示。"
          }
        }
      }
    },
