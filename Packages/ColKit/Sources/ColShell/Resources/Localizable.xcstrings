    "Tiroir already tidies your menu bar. Quit it, and Col takes over with the same drawers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir range déjà votre barre des menus. Quittez-le, et Col prend le relais avec les mêmes tiroirs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir räumt Ihre Menüleiste bereits auf. Beenden Sie Tiroir, und Col übernimmt mit denselben Schubladen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir ruimt je menubalk al op. Stop Tiroir, en Col neemt het over met dezelfde laden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir riordina già la barra dei menu. Esci da Tiroir, e Col prende il suo posto con gli stessi cassetti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir ya ordena tu barra de menús. Sal de Tiroir y Col tomará el relevo con los mismos cajones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tiroir já organiza sua barra de menus. Encerre o Tiroir, e o Col assume com as mesmas gavetas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroirがすでにメニューバーを整理しています。Tiroirを終了すると、Colが同じ引き出しのまま引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir가 이미 메뉴 막대를 정리하고 있습니다. Tiroir를 종료하면 Col이 같은 서랍으로 이어받습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir 已在整理你的菜单栏。退出 Tiroir 后，Col 会以相同的抽屉接手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir 已在整理你的選單列。結束 Tiroir 後，Col 會以相同的抽屜接手。"
          }
        }
      }
    },
