    "Asked when you turn on Downloads in progress, so Col can see files still being written.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé quand vous activez les téléchargements en cours, pour que Col voie les fichiers encore en cours d’écriture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird abgefragt, wenn Sie „Laufende Downloads“ aktivieren, damit Col Dateien sehen kann, die noch geschrieben werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevraagd wanneer je Lopende downloads aanzet, zodat Col bestanden kan zien die nog worden geschreven."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesto quando attivi Download in corso, così Col può vedere i file ancora in scrittura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicita al activar Descargas en curso, para que Col pueda ver los archivos que aún se están escribiendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitado quando você ativa Downloads em andamento, para que o Col veja os arquivos que ainda estão sendo gravados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード中のファイル」をオンにしたときに求められます。Colが書き込み中のファイルを確認できるようにするためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 다운로드를 켤 때 요청되며, Col이 아직 기록 중인 파일을 볼 수 있게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你打开“正在进行的下载”时请求，以便 Col 能看到仍在写入的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你開啟「進行中的下載」時請求，讓 Col 能看到仍在寫入的檔案。"
          }
        }
      }
    },
