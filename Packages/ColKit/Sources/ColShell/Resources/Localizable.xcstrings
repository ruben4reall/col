      }
    },
    "Your Souffleur scripts are here: the text comes out of the notch, right under the camera, at the pace of your voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos scripts de Souffleur sont là : le texte sort de l’encoche, juste sous la caméra, au rythme de votre voix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Souffleur-Skripts sind hier: Der Text kommt aus der Notch, direkt unter der Kamera, im Tempo Ihrer Stimme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Souffleur-scripts staan hier: de tekst komt uit de notch, vlak onder de camera, in het tempo van je stem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi script di Souffleur sono qui: il testo esce dal notch, proprio sotto la videocamera, al ritmo della tua voce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus guiones de Souffleur están aquí: el texto sale de la muesca, justo debajo de la cámara, al ritmo de tu voz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus roteiros do Souffleur estão aqui: o texto sai do notch, logo abaixo da câmera, no ritmo da sua voz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Souffleurの原稿はここにあります。テキストがノッチから、カメラのすぐ下に、声のペースに合わせて表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Souffleur 대본이 여기에 있습니다. 텍스트가 카메라 바로 아래의 노치에서 사용자의 목소리 속도에 맞춰 나옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Souffleur 讲稿都在这里：文本会从刘海中出现，就在摄像头正下方，并跟随你的语速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Souffleur 講稿都在這裡：文字會從瀏海中出現，就在相機正下方，並跟隨你的語速。"
          }
        }
      }
    },
