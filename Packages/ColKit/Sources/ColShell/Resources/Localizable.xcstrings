    "A development build never opens at login: the Col in Applications does.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une build de développement ne s’ouvre jamais à la connexion : c’est le Col du dossier Applications qui s’ouvre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Entwicklungs-Build öffnet sich nie bei der Anmeldung: Das tut das Col im Ordner „Programme“."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ontwikkelbuild opent nooit bij inloggen: dat doet de Col in Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una build di sviluppo non si apre mai al login: lo fa il Col nella cartella Applicazioni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compilación de desarrollo nunca se abre al iniciar sesión: lo hace el Col de Aplicaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
