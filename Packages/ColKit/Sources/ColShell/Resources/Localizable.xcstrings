    "The title shows for a moment when a track starts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre s’affiche un instant au début d’un morceau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel erscheint kurz, wenn ein Song beginnt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De titel verschijnt even wanneer een nummer begint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo appare per un momento quando inizia un brano."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título aparece un momento cuando empieza una canción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título aparece por um instante quando uma música começa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲が始まると、タイトルが少しの間表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙이 시작되면 제목이 잠시 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目开始时会短暂显示标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目開始時會短暫顯示標題。"
          }
        }
      }
    },
    "The words of the song beside the player, line by line, whatever plays: Spotify, Apple Music, Deezer or your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles à côté du lecteur, ligne par ligne, quoi qui joue : Spotify, Apple Music, Deezer ou votre navigateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext neben dem Player, Zeile für Zeile, egal was läuft: Spotify, Apple Music, Deezer oder Ihr Browser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De songtekst naast de speler, regel voor regel, wat er ook speelt: Spotify, Apple Music, Deezer of je browser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo del brano accanto al player, riga per riga, qualunque cosa sia in riproduzione: Spotify, Apple Music, Deezer o il tuo browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra de la canción junto al reproductor, línea a línea, suene lo que suene: Spotify, Apple Music, Deezer o tu navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A letra da música ao lado do player, linha por linha, toque o que tocar: Spotify, Apple Music, Deezer ou o seu navegador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を再生していても、プレーヤーの横に歌詞を1行ずつ表示します。Spotify、Apple Music、Deezer、ブラウザに対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 재생하든 플레이어 옆에 노래 가사가 한 줄씩 표시됩니다(Spotify, Apple Music, Deezer 또는 브라우저)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论播放什么，播放器旁都会逐行显示歌词：Spotify、Apple Music、Deezer 或你的浏览器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論播放什麼，播放器旁都會逐行顯示歌詞：Spotify、Apple Music、Deezer 或你的瀏覽器。"
          }
        }
      }
    },
    "The words of the song beside the player, line by line. Titles go to LRCLIB, an open database.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles à côté du lecteur, ligne après ligne. Les titres sont envoyés à LRCLIB, une base ouverte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext neben dem Player, Zeile für Zeile. Titel gehen an LRCLIB, eine offene Datenbank."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De songtekst naast de speler, regel voor regel. Titels gaan naar LRCLIB, een open database."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo del brano accanto al player, riga per riga. I titoli vengono inviati a LRCLIB, un database aperto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra de la canción junto al reproductor, línea a línea. Los títulos se envían a LRCLIB, una base de datos abierta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A letra da música ao lado do player, linha por linha. Os títulos vão para o LRCLIB, um banco de dados aberto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーヤーの横に歌詞を1行ずつ表示します。曲名は、オープンなデータベースLRCLIBに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어 옆에 노래 가사가 한 줄씩 표시됩니다. 제목은 공개 데이터베이스인 LRCLIB로 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器旁逐行显示歌词。歌曲标题会发送到开放数据库 LRCLIB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器旁逐行顯示歌詞。歌曲標題會傳送至開放資料庫 LRCLIB。"
          }
        }
      }
    },
