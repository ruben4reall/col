    "What you copied, kept in memory only. Only the copies you pin are saved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez copié, gardé en mémoire seulement. Seules les copies épinglées sont enregistrées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie kopiert haben, nur im Speicher gehalten. Nur angeheftete Kopien werden gesichert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je hebt gekopieerd, alleen in het geheugen bewaard. Alleen vastgezette kopieën worden bewaard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che hai copiato, conservato solo in memoria. Vengono salvate solo le copie che fissi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que has copiado, guardado solo en la memoria. Solo se guardan las copias que fijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você copiou, mantido só na memória. Só as cópias que você fixar são salvas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたものはメモリ内にのみ保持されます。保存されるのは、ピンで固定したコピーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 항목은 메모리에만 보관됩니다. 고정한 항목만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你拷贝的内容仅保留在内存中。只有你固定的拷贝内容才会被存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你拷貝的內容僅保留在記憶體中。只有你釘選的拷貝內容才會被儲存。"
          }
        }
      }
    },
    "When several things run": {
