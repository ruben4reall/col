    "When you plug in, and at 20 % and 10 %.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous branchez, puis à 20 % et 10 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anschließen und sowohl bei 20 % als auch bei 10 %."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het aansluiten, en zowel bij 20% als bij 10%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando colleghi l’alimentatore, poi al 20% e al 10%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al conectar el cargador, y al 20 % y al 10 %."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao conectar o carregador e quando a bateria chega a 20%, depois a 10%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に接続したとき、およびバッテリー残量が20%と10%になったとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원을 연결할 때, 그리고 20%와 10%일 때."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入电源时，以及电量为 20% 和 10% 时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接上電源時，以及電量為 20% 和 10% 時。"
          }
        }
      }
    },
    "Where the prompter appears": {
