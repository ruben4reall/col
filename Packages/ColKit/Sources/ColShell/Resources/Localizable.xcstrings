    "Do each gesture on the real notch, at the top of your screen. Each one ticks itself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites chaque geste sur la vraie encoche, en haut de l’écran. Chacun se coche tout seul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie jede Geste an der echten Notch oben auf Ihrem Bildschirm aus. Jede hakt sich von selbst ab."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe elk gebaar op de echte notch, bovenaan je scherm. Elk gebaar vinkt zichzelf af."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai ogni gesto sul notch vero, in cima allo schermo. Ognuno si spunta da solo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz cada gesto en la muesca real, en la parte superior de la pantalla. Cada uno se marca solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça cada gesto no notch de verdade, no topo da tela. Cada um é marcado sozinho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部の実際のノッチで、各ジェスチャを試してください。試したものには自動でチェックが付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 상단의 실제 노치에서 각 제스처를 해 보세요. 완료하면 자동으로 체크됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕顶部真正的刘海上做出每个手势。完成后会自动打勾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在螢幕頂端真正的瀏海上做出每個手勢。完成後會自動打勾。"
          }
        }
      }
    },
