          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een code-editor met AI: open hem vanaf het eiland."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un editor di codice con IA: aprilo dall’isola."
          }
        },
        "es": {
