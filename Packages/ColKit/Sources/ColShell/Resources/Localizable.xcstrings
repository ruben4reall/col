    "Read only while the widget shows in the island.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu seulement pendant que le widget s’affiche dans l’île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur gelesen, während das Widget auf der Insel angezeigt wird."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gelezen terwijl de widget op het eiland wordt getoond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto solo mentre il widget è visibile nell’isola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se lee mientras el widget se muestra en la isla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido só enquanto o widget aparece na ilha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットがアイランドに表示されている間だけ読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯이 아일랜드에 표시되는 동안에만 읽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在小组件显示于岛中时读取。"
          }
