        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorre a un ritmo costante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza a un ritmo constante."
          }
        },
        "pt-BR": {
