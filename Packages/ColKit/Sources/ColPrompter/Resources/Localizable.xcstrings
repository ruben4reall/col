    "Col can't hear you: microphone access is off.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Col ne vous entend pas : l’accès au micro est désactivé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Col kann Sie nicht hören: Der Mikrofonzugriff ist deaktiviert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Col kan je niet horen: microfoontoegang staat uit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Col non ti sente: l’accesso al microfono è disattivato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Col no te oye: el acceso al micrófono está desactivado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Col não consegue ouvir você: o acesso ao microfone está desativado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Colに声が届きません。マイクへのアクセスがオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Col이 사용자의 목소리를 들을 수 없습니다. 마이크 접근이 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Col 听不到你的声音：麦克风访问权限已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Col 聽不到你的聲音：麥克風取用權限已關閉。"
          }
        }
      }
    },
