    "Write a new script, or drop a text file, a Word document, a PDF or a presentation here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez un nouveau script, ou déposez ici un fichier texte, un document Word, un PDF ou une présentation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie ein neues Skript oder legen Sie hier eine Textdatei, ein Word-Dokument, ein PDF oder eine Präsentation ab."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een nieuw script, of sleep hier een tekstbestand, een Word-document, een PDF of een presentatie naartoe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un nuovo script, oppure trascina qui un file di testo, un documento Word, un PDF o una presentazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un guion nuevo, o arrastra aquí un archivo de texto, un documento de Word, un PDF o una presentación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um novo roteiro ou solte aqui um arquivo de texto, um documento do Word, um PDF ou uma apresentação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい原稿を書くか、テキストファイル、Word書類、PDF、プレゼンテーションをここにドロップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 대본을 작성하거나 텍스트 파일, Word 문서, PDF 또는 프레젠테이션을 여기로 드롭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写新讲稿，或将文本文件、Word 文档、PDF 或演示文稿拖放到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
