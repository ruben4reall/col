    "Roll the script at the pace you just read at.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire défiler le script au rythme que vous venez de lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript in dem Tempo laufen lassen, in dem Sie gerade gelesen haben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het script lopen in het tempo waarin je net las."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scorrere lo script al ritmo con cui hai appena letto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplazar el guion al ritmo al que acabas de leer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolar o roteiro no ritmo em que você acabou de ler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今読んだペースで原稿をスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 읽은 속도로 대본을 넘깁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你刚才的朗读速度滚动讲稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按你剛才的朗讀速度捲動講稿。"
          }
        }
      }
    },
    "Rolls at a steady pace.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défile à un rythme régulier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft in gleichmäßigem Tempo."
