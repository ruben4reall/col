    "Voice follow can't hear %@ on this Mac yet. Rolling at your pace instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi de la voix ne comprend pas encore le %@ sur ce Mac. Le script défile à votre rythme à la place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmverfolgung versteht %@ auf diesem Mac noch nicht. Das Skript läuft stattdessen in Ihrem Tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stem volgen kan %@ op deze Mac nog niet verstaan. Het script loopt in plaats daarvan in jouw tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la voce non supporta ancora la lingua %@ su questo Mac. Lo script scorre invece al tuo ritmo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento de voz aún no reconoce %@ en este Mac. En su lugar, el guion avanza a tu ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir a Voz ainda não entende %@ neste Mac. Em vez disso, o roteiro rola no seu ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声追従は、このMacではまだ%@を聞き取れません。代わりにあなたのペースでスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 아직 음성 추적이 %@을(를) 인식할 수 없습니다. 대신 사용자의 속도로 넘어갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音跟随在此 Mac 上尚无法识别 %@，将改为按你的速度滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音跟隨在此 Mac 上尚無法辨識 %@，將改為按你的速度捲動。"
          }
        }
      }
    },
    "Voice follow stopped hearing words. Rolling at your pace instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi de la voix n’entend plus de mots. Le script défile à votre rythme à la place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmverfolgung hört keine Wörter mehr. Das Skript läuft stattdessen in Ihrem Tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stem volgen hoort geen woorden meer. Het script loopt in plaats daarvan in jouw tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui la voce non sente più parole. Lo script scorre invece al tuo ritmo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento de voz ha dejado de oír palabras. En su lugar, el guion avanza a tu ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir a Voz parou de ouvir palavras. Em vez disso, o roteiro rola no seu ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声追従が言葉を聞き取れなくなりました。代わりにあなたのペースでスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 추적에서 더 이상 단어가 인식되지 않습니다. 대신 사용자의 속도로 넘어갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音跟随已听不到字词，将改为按你的速度滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音跟隨已聽不到字詞，將改為按你的速度捲動。"
          }
        }
      }
    },
