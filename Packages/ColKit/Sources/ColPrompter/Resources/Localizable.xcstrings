    "Rolls while you speak, waits when you pause.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défile pendant que vous parlez, attend quand vous faites une pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft, während Sie sprechen, und wartet, wenn Sie eine Pause machen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt terwijl je spreekt, wacht als je pauzeert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorre mentre parli, aspetta quando fai una pausa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza mientras hablas y espera cuando haces una pausa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rola enquanto você fala e espera quando você faz uma pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している間はスクロールし、間を置くと待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 동안 넘어가고, 멈추면 기다립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说话时滚动，你停顿时等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你說話時捲動，你停頓時等待。"
          }
        }
      }
    },
